# Solvers on Tempo: environment of the API (solvers-tempo-api), the worker (solvers-tempo-worker) and the server CLIs.
# Source of truth: apps/server/src/env.ts (every variable below is validated there). Copy to apps/server/.env.
# Never commit a filled copy. Keys may be given as 0x hex or as a path to a key file under apps/server/.keys (gitignored).
# Web variables (NEXT_PUBLIC_*) are listed in apps/web (phase 5).

# ---- process ----
NODE_ENV=development
PORT=3018
PUBLIC_API_URL=http://localhost:3018
PUBLIC_WEB_URL=http://localhost:3001
# Hosts accepted in SIWE messages, comma separated (empty = hosts of PUBLIC_WEB_URL and PUBLIC_API_URL)
SIWE_DOMAINS=
# Dev Postgres 16 + pgvector: container solvers-tempo-pg on port 5546 (never 5433/5543/5544)
DATABASE_URL=postgres://solvers:solvers@127.0.0.1:5546/solvers_tempo

# ---- chain (Tempo) ----
# 4217 = mainnet, 42431 = Moderato testnet, 31337 = local anvil --tempo
CHAIN_ID=42431
RPC_URL=https://rpc.moderato.tempo.xyz
RPC_WS_URL=
# Empty = default explorer of the chain (Moderato: https://explore.testnet.tempo.xyz)
EXPLORER_URL=
# TIP-20 payment token (pathUSD on Moderato). Decimals are checked on-chain at boot.
PAYMENT_TOKEN=0x20c0000000000000000000000000000000000000
PAYMENT_TOKEN_DECIMALS=6
PAYMENT_TOKEN_SYMBOL=USD
# deployments/<CHAIN_ID>.json; empty = addresses generated into @solvers/contracts-client
DEPLOYMENTS_FILE=
# Optional per-contract overrides (normally empty)
CONTRACT_REGISTRY=
CONTRACT_LICENSE=
CONTRACT_CREDITS=
CONTRACT_REVIEWS=
CONTRACT_ESCROW=
CONTRACT_STAKING=

# ---- server keys (D11). Generate fresh keys per environment; never reuse keys across networks. ----
# The API needs PLATFORM, RELAY and VERIFIER plus TREASURY_ADDRESS; the worker needs none of them.
# PLATFORM: holds the stablecoin float; PLATFORM_ROLE + USAGE_ROLE (Pix / agent-pay fulfilment, usage batches)
PLATFORM_PRIVATE_KEY=
# RELAY: pays network fees only (relay + in-process sponsorship). Holds NO contract role. Must differ from PLATFORM off the local chain.
RELAY_PRIVATE_KEY=
# VERIFIER: markPassed / setEval (VERIFIER_ROLE)
VERIFIER_PRIVATE_KEY=
# ADMIN: development/demo CLIs only. FORBIDDEN with CHAIN_ID=4217 (the server refuses to start); use --key-file on mainnet.
ADMIN_PRIVATE_KEY=
# Fee recipient (cold wallet); must equal the Registry's treasury
TREASURY_ADDRESS=

# ---- relay (D3) ----
RELAY_ENABLED=true
RELAY_MAX_GAS_PER_TX=6000000
RELAY_DAILY_GAS_PER_WALLET=60000000
# Per IPv4 address or IPv6 /64
RELAY_DAILY_GAS_PER_IP=200000000
# Ceiling of all sponsored gas per rolling 24 h (admins alerted when reached)
RELAY_DAILY_GAS_GLOBAL=2000000000
# Gas price caps of sponsored transactions (fee-token base units per gas)
RELAY_MAX_FEE_PER_GAS=50000000000
RELAY_MAX_PRIORITY_FEE_PER_GAS=2000000000
# Admin alert when PLATFORM or RELAY holds less than this (token base units; 50000000 = 50 USD)
FLOAT_LOW_BALANCE_UNITS=50000000

# ---- indexer (D9) ----
INDEXER_ENABLED=true
INDEXER_POLL_MS=1000
INDEXER_CONFIRMATIONS=1
# Blocks per eth_getLogs (Moderato caps ranges at 100000)
INDEXER_BLOCK_BATCH=2000
# Empty = deployBlock of the deployment
INDEXER_START_BLOCK=

# ---- auth ----
# At least 32 characters
JWT_SECRET=
# 32 random bytes, base64 (encrypts memory keys)
SERVER_KEK=
# Privy (owner's dashboard): app id and the ES256 verification key (PEM). Empty = Privy linking off.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
PRIVY_VERIFICATION_KEY=

# ---- testnet helpers ----
# Faucet for test wallets (ignored on mainnet). Amount in whole stablecoin units.
FAUCET_ENABLED=false
FAUCET_AMOUNT=50

# ---- catalog, packages, search ----
EMBEDDING_MODEL=Xenova/multilingual-e5-small
SEARCH_MODE=local
SEARCH_DAILY_QUOTA=300
AGENTS_DIR=../../agents
PUBLISHED_DIR=./data/packages
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- creator flow (worker) ----
SUBMISSIONS_DIR=./data/submissions
# Wallets that review submissions on the site (comma separated). Reviewing on the site signs nothing on-chain.
ADMIN_WALLETS=
SUBMISSION_MAX_ZIP_BYTES=52428800
SUBMISSION_MAX_UNZIPPED_BYTES=157286400
SUBMISSION_MAX_FILES=2000
SUBMISSION_MAX_PENDING=3
SUBMISSION_MAX_PER_DAY=5
# true = validate in the API process (tests only); production uses the worker
SUBMISSIONS_INLINE=false

# ---- guarantees and deliverable verification ----
DELIVERABLES_DIR=./deliverables
VERIFIER_IMAGE=solvers-tempo-react-test
# docker | simulated
VERIFIER_MODE=docker
ESCROW_REVIEW_WINDOW_SECS=259200
AUTO_RELEASE_ENABLED=true
GUARANTEE_MIN_SALES=10
GUARANTEE_MIN_RATING=4

# ---- alerts, limits ----
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
RATE_LIMIT_PER_MINUTE=60

# ---- Pix via Mercado Pago (D10). Pix stays off on mainnet until docs/payments-open-questions.md is answered. ----
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=
# Empty = true off mainnet
MP_TEST_MODE=
# Simulated Pix approval; empty = true off mainnet; always false on mainnet
PIX_SIMULATE=
# Fallback USD->BRL rate when the FX API fails
BRL_PER_USD=5.4

# ---- agent payments over MPP (D4) ----
AGENT_PAY_ENABLED=false
# Secret that signs MPP challenges (required when AGENT_PAY_ENABLED=true)
MPP_SECRET_KEY=
MPP_REALM=
# Price bounds in whole stablecoin units; orders expire after the TTL
AGENT_PAY_MIN_PRICE=5
AGENT_PAY_MAX_PRICE=100
AGENT_PAY_ORDER_TTL_SECS=900

# ---- Solana Pay: the buyer pays in USDC on Solana, the platform buys on Tempo from its float (like Pix) ----
SOLANA_PAY_ENABLED=false
# devnet | mainnet-beta; empty = the network paired with CHAIN_ID (devnet off mainnet, mainnet-beta on 4217); a mismatch is refused
SOLANA_CLUSTER=
# Empty = the public endpoint of the cluster (use a private RPC on mainnet-beta)
SOLANA_RPC_URL=
# SPL mint accepted; empty = Circle USDC of the cluster. Its decimals must equal PAYMENT_TOKEN_DECIMALS (checked at first use)
SOLANA_PAY_MINT=
# solana-keygen JSON file (e.g. .keys/solana-devnet-platform.json): the wallet that receives the payments; it also signs
# the automatic refunds and pays their fee, so it needs a little SOL. Required when SOLANA_PAY_ENABLED=true
SOLANA_PAY_KEYPAIR=
# Minutes an unpaid charge stays open (a payment is still accepted for 5 minutes after that; an expired charge is
# re-scanned for 72 h and a late payment is completed or refunded)
SOLANA_PAY_TTL_MIN=30
# With CHAIN_ID=4217 only Circle USDC (EPjFWdd5AufqSSqeM2qN1xzybapC8G4wEGGkZwyTDt1v) is accepted unless this is true
SOLANA_PAY_ALLOW_CUSTOM_MINT=false
