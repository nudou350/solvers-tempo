{
  "name": "@solvers/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "worker": "node --env-file-if-exists=.env dist/worker/index.js",
    "worker:dev": "tsx watch --env-file-if-exists=.env src/worker/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('fs').cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "node --env-file-if-exists=.env.test --import tsx --test --test-concurrency=1 test/*.test.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts",
    "cli:publish": "tsx --env-file-if-exists=.env src/cli/publish.ts",
    "cli:seed": "tsx --env-file-if-exists=.env src/cli/seed.ts",
    "cli:reindex": "tsx --env-file-if-exists=.env src/cli/reindex.ts",
    "cli:validate": "tsx src/cli/validate.ts",
    "cli:schema": "tsx src/cli/schema.ts",
    "cli:invite": "tsx --env-file-if-exists=.env src/cli/invite.ts",
    "cli:images": "tsx --env-file-if-exists=.env src/cli/images.ts",
    "cli:admin": "tsx --env-file-if-exists=.env src/cli/admin.ts",
    "cli:approve": "tsx --env-file-if-exists=.env src/cli/approve.ts",
    "cli:suspend": "tsx --env-file-if-exists=.env src/cli/suspend.ts",
    "cli:ledger-export": "tsx --env-file-if-exists=.env src/cli/ledger-export.ts",
    "cli:treasury-status": "tsx --env-file-if-exists=.env src/cli/treasury-status.ts"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.4.0",
    "@solvers/chain": "workspace:*",
    "@solvers/contracts-client": "workspace:*",
    "@solvers/shared": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.45.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.1.0",
    "jose": "^6.2.12",
    "mppx": "^0.13.4",
    "pg": "^8.16.0",
    "qrcode": "^1.5.4",
    "sharp": "^0.35.5",
    "viem": "^2.57.4",
    "yauzl": "^3.4.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^22.0.0",
    "@types/pg": "^8.15.0",
    "@types/qrcode": "^1.5.6",
    "@types/yauzl": "^3.4.0",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
