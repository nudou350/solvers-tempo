# Web app environment (copy to apps/web/.env.local; never commit real values). NEXT_PUBLIC_* are inlined at build time.

# Tempo chain this build targets: 42431 (Moderato testnet), 4217 (mainnet), 31337 (local anvil --tempo).
# Must match CHAIN_ID of the API (/api/config). On 4217 the dev wallet is always refused.
NEXT_PUBLIC_CHAIN_ID=42431

# Privy app id (dashboard: Configuration > App settings). Empty = no e-mail login.
NEXT_PUBLIC_PRIVY_APP_ID=

# 1 = offer the dev wallet (test key in the browser's localStorage). Test networks only.
NEXT_PUBLIC_ALLOW_DEV_WALLET=1

# API origin seen by the browser. Empty = same origin (dev rewrites to API_DEV_URL; production nginx).
NEXT_PUBLIC_API_URL=

# 1 = show /dev/kit in a production build.
NEXT_PUBLIC_SHOW_DEV_KIT=

# Server-side (not inlined): API for server components and the dev rewrites.
API_INTERNAL_URL=http://127.0.0.1:3018
API_DEV_URL=http://localhost:3018
